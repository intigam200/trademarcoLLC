# Resend API key used by api/contact.js to send RFQ form submissions.
# Get one at https://resend.com — set this in Vercel Project Settings > Environment Variables,
# and copy this file to .env locally if testing with `vercel dev`.
RESEND_API_KEY=

# Optional: sender address for outgoing RFQ emails.
# Without a verified domain on Resend, you can only send FROM their sandbox domain:
#   RESEND_FROM=TradeMarco RFQ <onboarding@resend.dev>
# Once trademarco.com is verified in Resend, switch to a real address, e.g.:
#   RESEND_FROM=TradeMarco RFQ <noreply@trademarco.com>
RESEND_FROM=
