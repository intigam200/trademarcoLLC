# SMTP credentials used by api/rfq.js (via Nodemailer) to send the sales
# notification (to sales@trademarco.com) and the customer confirmation email
# for every RFQ submission. Get these from your email/SMTP provider (Northwest).
SMTP_HOST=
SMTP_PORT=
# "true" for port 465 (implicit TLS), "false" for port 587/25 (STARTTLS). Leave blank to
# auto-detect from the port (465 = secure, everything else = not secure).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER if not set. Must usually be an address the SMTP account
# is authorized to send as.
SMTP_FROM=

# Cloudflare Turnstile — invisible spam/bot protection on the public RFQ
# form. Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# (Widget mode: "Invisible" or "Managed" both work — api/_lib/verifyTurnstile.js
# does the actual server-side check). VITE_ prefix means the site key is exposed
# to the browser bundle — that's expected and safe, it's a public key.
# Until both are set, RFQ submissions still work but are honeypot-protected only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase — backend for the catalog (products/manufacturers/categories),
# RFQs and admin auth. From your Supabase project: Dashboard > Project
# Settings > API. VITE_ prefix means these two are exposed to the browser
# bundle — that's expected, the anon key is safe to expose and every table
# is protected by Row Level Security (see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — used by scripts/import-products.mjs and api/admin/image-fetch.js
# to bulk-write products / upload product photos, bypassing RLS. From
# Dashboard > Project Settings > API > service_role key.
# NEVER prefix this with VITE_, never expose it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Google Custom Search — powers "Search Images" in the admin product editor
# (api/admin/image-search.js, api/admin/image-fetch.js), so photos can be
# picked without leaving the admin panel. Server-only, never exposed to the
# browser. See README.md ("Admin product image search") for setup steps.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
