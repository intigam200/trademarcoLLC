# SMTP credentials used by api/contact.js (via Nodemailer) to send RFQ form submissions
# to info@/sales@/admin@trademarco.com. Get these from your email/SMTP provider (Northwest).
SMTP_HOST=
SMTP_PORT=
# "true" for port 465 (implicit TLS), "false" for port 587/25 (STARTTLS). Leave blank to
# auto-detect from the port (465 = secure, everything else = not secure).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER if not set. Must usually be an address the SMTP account
# is authorized to send as.
SMTP_FROM=

# Admin panel authentication (api/admin/*.js). There is a single admin
# identity, no registration/sign-up. Generate ADMIN_PASSWORD_HASH locally
# with: node scripts/hash-admin-password.mjs "your-password" — never put
# the plaintext password here or anywhere else.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Any long random string (e.g. `openssl rand -hex 32`), used to sign admin session tokens.
ADMIN_JWT_SECRET=
